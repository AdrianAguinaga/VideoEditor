     "type": "array"
    }
   },
   "required": [
    "id",
    "start_ms",
    "end_ms",
    "text"
   ],
   "title": "Segment",
   "type": "object"
  },
  "Word": {
   "additionalProperties": false,
   "properties": {
    "start_ms": {
     "minimum": 0,
     "title": "Start Ms",
     "type": "integer"
    },
    "end_ms": {
     "minimum": 0,
     "title": "End Ms",
     "type": "integer"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "probability": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
