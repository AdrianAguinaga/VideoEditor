    }
   },
   "required": [
    "start_ms",
    "end_ms",
    "text"
   ],
   "title": "Word",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "Raw ASR output. Never edited in place; a reviewed text goes in a separate file.",
 "properties": {
  "schema_version": {
   "const": 1,
   "default": 1,
   "title": "Schema Version",
   "type": "integer"
  },
  "video": {
   "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
   "title": "Video",
   "type": "string"
  },
  "input_id": {
   "maxLength": 64,
   "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
   "title": "Input Id",
   "type": "string"
  },
  "input_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "title": "Input Sha256",
   "type": "string"
  },
  "language": {
   "title": "Language",
   "type": "string"
  },
  "language_probability": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Language Probability"
  },
  "duration_ms": {
   "minimum": 0,
   "title": "Duration Ms",
   "type": "integer"
  },
  "created_at": {
   "title": "Created At",
   "type": "string"
  },
  "backend": {
   "$ref": "#/$defs/BackendInfo"
  },
  "segments": {
   "items": {
    "$ref": "#/$defs/Segment"
   },
   "title": "Segments",
   "type": "array"
  },
  "limitations": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Limitations",
   "type": "array"
  }
 },
 "required": [
  "video",
  "input_id",
  "input_sha256",
  "language",
  "duration_ms",
  "created_at",
  "backend",
  "segments"
 ],
 "title": "Transcript",
 "type": "object"
}
