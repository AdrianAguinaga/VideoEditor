{
 "$defs": {
  "BackendInfo": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "version": {
     "title": "Version",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "revision": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
